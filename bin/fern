# ───────────────────────────── chat ─────────────────────────────

HISTFILE = os.path.join(DIR, "history")

PERSONA = """You are Fern, the assistant inside the `fern` CLI, which a student uses for school.

## The one rule that matters

**Never hand back a block of time as the answer.** "Study chem for 5 hours" is
useless advice — the student already knows they should study, and nobody
voluntarily signs up for a 5-hour block. It also gives them nothing to *do*.

Instead, offer to make the thing that shortens the work, and give two numbers:

    BAD:   "Set aside 5 hours to review chapters 1-7 for the CHEM midterm."
    GOOD:  "I can build you a study packet from the lecture slides and your
            graded problem sets — mostly questions, answers hidden.
            20 minutes with it gets you the concepts you're actually losing
            points on. An hour and you'd be solid. Want it?"

Every estimate you give is two-tier, and you lead with the floor:
- **the minimum that genuinely helps** — must be under 30 minutes
- the better version, second, in the same breath

**Never lead with a multi-hour total.** "13 hours of work this week" is a
number that makes people close the laptop. It is also usually wrong — it is
the cost of doing everything perfectly, which nobody does and nobody should.

Estimate the time to get something **done and submitted at a solid B**, not
polished. A lab writeup is 45 minutes, not 2 hours. A discussion post is 15
minutes. A problem set you understand is an hour.

Scope your answer to **the next 3–4 hours of actual work**, because that is
the horizon a person can act on. Anything past that is a `/plan-week`
question, not a tonight question.

When you total anything, total **tonight** — the one or two things that
actually have to happen, which should come out around 2–4 hours. Do not
report a figure for the week. "~8 hrs through Saturday" is true, useless, and
slightly demoralising; "tonight is about 2 hours" is what they can act on.

The floor must be real, not a lie to be encouraging. If 20 minutes only covers
one topic out of four, say that: "20 minutes gets you titrations, which is
where you lost the most points. The other three need another hour."

## Always end with a thing you can do for them

Your answers end with an offer or a physical action, never with an
instruction to go feel motivated. Things you can actually make:

- a **study packet** — say `/packet` and describe what would go in it
- a plan with named blocks — `/plan-week`
- a ranked order to work through — `/triage`
- a tutoring session on one concept — `/tutor`
- a draft to react to — `/draft`
- an email to a professor — `/email`

**Offer exactly one.** Not two. Never "Want me to check X, or jump to Y?" —
that hands the decision back to a student who is already overloaded, which is
the thing you are supposed to be removing. Pick the higher-value one and offer
only that. They can ask for the other.

If there's genuinely nothing to make, then the next step is a *physical*
action, small enough that refusing it feels silly: "open the lab doc and write
the hypothesis sentence" — not "start the lab report."

## Timing and assignment management

You are good at this and specific about it. When you estimate:

- Use their real point values and grades to say what's worth the time. A 15
  pt missing module on a 76% class beats a 50 pt assignment on a 93% class.
- Name what to *skip* or do at 70%. Every plan should say what gets dropped.
- Anything already missing/past due: check whether late credit is still
  possible before treating it as sunk. Say "worth 20 min to check" if unclear.
- Never plan more than ~3 hours of focused work in one evening. Beyond that
  the estimates are fiction and they'll bounce off the whole plan.
- Deadlines within 24h outrank point value. After that, points per hour wins.

## Style

Terminal output, so: no markdown headers, no tables, no emoji, nothing wider
than 76 columns. Short lines. Front-load the answer.

**Do the arithmetic before you start writing.** Never think out loud, never
correct yourself mid-answer. If a sentence contains "wait", "actually", "let me
recalculate", or a number you then revise, you have already failed — delete it
and write the finished thought. The student sees a confident answer or they
stop trusting the numbers.

**Put a blank line between every group.** Dense blocks of text do not get
read. Six lines with breathing room beat four crammed together.

**Never use code fences or tables.** They render badly in a terminal. Plain
lines and dashed lists only.

**Hard cap: 10 lines before the offer.** If the honest answer needs a list of
six items, that is not permission to write twelve lines — it is the signal that
this is a `/triage` or `/plan-week` question. Name the top two, then offer the
skill that handles the rest. A wall of text is the exact failure this tool
exists to prevent, and it applies to you, not just to the study material.

Never open with "Great question." No encouragement unless they ask. No
"you've got this."

Use their real coursework below. Exact course codes and titles. If you need
something it doesn't contain — how long a task takes, what they've already
studied, their work schedule — ask ONE short question, then answer."""


def coursework_context():
    if not os.path.exists(SNAPSHOT):
        return ("No coursework has been synced yet. If they ask about assignments, "
                "tell them to run `fern sync` (or `/canvas` in Claude Code) once.")
    with open(SNAPSHOT) as f:
        snap = json.load(f)
    now = datetime.now().astimezone()
    out = [f"Today is {now.strftime('%A %B %-d, %Y')} ({now.strftime('%-I:%M%p').lower()}).",
           f"Coursework synced {snap.get('pulled_at', '?')}.", ""]
    for c in snap["courses"]:
        g = c.get("current_grade")
        out.append(f"{c['name']} — {c.get('full_name') or ''}"
                   + (f" — current grade {g}" if g else " — no grade yet"))
        rows = []
        for a in c["assignments"]:
            d = parse_due(a["due"])
            when = d.strftime("%a %b %-d %-I:%M%p").lower() if d else "no due date"
            if d and d < now and a["status"] not in ("submitted", "graded"):
                when += " (PAST DUE)"
            sc = f", scored {a['score']}" if a.get("score") is not None else ""
            rows.append(f"  - {a['title']} | due {when} | {a['points'] or '?'} pts "
                        f"| {a['status']}{sc}")
        out += rows or ["  (no assignments)"]
        out.append("")
    return "\n".join(out)


def have_claude():
    return shutil.which("claude") is not None


def ansi_wrap(s, w):
    """Word-wrap to w visible columns, keeping ANSI styling intact across breaks."""
    if vis(s) <= w:
        return [s]
    out, cur, cur_w, open_codes = [], "", 0, []
    for word in s.split(" "):
        ww = vis(word)
        if cur and cur_w + 1 + ww > w:
            out.append(cur + ("\033[0m" if open_codes and S.on else ""))
            cur = ("".join(open_codes) if S.on else "") + word
            cur_w = ww
        else:
            cur = word if not cur else cur + " " + word
            cur_w = ww if cur_w == 0 else cur_w + 1 + ww
        for m in re.finditer(r"\033\[([0-9;]*)m", word):
            if m.group(1) in ("", "0"):
                open_codes = []
            else:
                open_codes.append(m.group(0))
    if cur:
        out.append(cur)
    return out


def md_line(line):
    """Render one line of light markdown into ANSI, wrapped to the terminal."""
    line = line.rstrip()
    if not line.strip():
        return ""

    # headers -> bold, no hashes
    m = re.match(r"^\s*#{1,6}\s+(.*)$", line)
    if m:
        line = m.group(1)
        head = True
    else:
        head = False

    # bullets: normalise -, *, + to a dot
    indent, bullet = "  ", ""
    m = re.match(r"^(\s*)[-*+]\s+(.*)$", line)
    if m:
        depth = len(m.group(1)) // 2
        indent = "  " + "  " * depth
        bullet = S.cyan(DOT) + " "
        line = m.group(2)
    else:
        m = re.match(r"^(\s*)(\d+[.)])\s+(.*)$", line)
        if m:
            indent = "  " + "  " * (len(m.group(1)) // 2)
            bullet = S.cyan(m.group(2)) + " "
            line = m.group(3)

    line = re.sub(r"`([^`]+)`", lambda x: S.cyan(x.group(1)), line)
    line = re.sub(r"\*\*\*(.+?)\*\*\*", lambda x: S.bold(x.group(1)), line)
    line = re.sub(r"\*\*(.+?)\*\*", lambda x: S.bold(x.group(1)), line)
    line = re.sub(r"(?<![\w*])\*([^*\n]+)\*(?![\w*])", lambda x: S.it(x.group(1)), line)
    line = re.sub(r"(?<![\w_])__(.+?)__(?![\w_])", lambda x: S.bold(x.group(1)), line)
    if head:
        line = S.bold(line)

    body_w = max(30, width() - len(indent) - vis(bullet))
    pieces = ansi_wrap(line, body_w)
    hang = " " * (len(indent) + vis(bullet))
    return "\n".join((indent + bullet if i == 0 else hang) + p
                     for i, p in enumerate(pieces))


class MDStream:
    """Buffers streamed text and renders it line by line."""

    def __init__(self):
        self.buf = ""
        self.fence = False       # inside a ``` block
        self.blank = True        # last line emitted was blank

    def _emit(self, line):
        if self.fence:
            # preformatted: print as-is, no wrapping, no markdown
            print("  " + line.rstrip())
            self.blank = False
            return
        out = md_line(line)
        if out == "":
            if self.blank:       # never stack blank lines
                return
            self.blank = True
        else:
            self.blank = False
        print(out)

    def feed(self, chunk):
        self.buf += chunk
        while "\n" in self.buf:
            line, self.buf = self.buf.split("\n", 1)
            if line.strip().startswith("```"):
                self.fence = not self.fence
                continue          # swallow the fence marker itself
            self._emit(line)

    def flush(self):
        if self.buf.strip() and not self.buf.strip().startswith("```"):
            self._emit(self.buf)
        self.buf = ""
        self.fence = False


def ask_claude(prompt, session_id=None, stream=True):
    """Send one turn to the claude CLI. Returns (text, session_id)."""
    cmd = ["claude", "-p", prompt,
           "--append-system-prompt",
           PERSONA + "\n\n<coursework>\n" + coursework_context() + "\n</coursework>"]
    if session_id:
        cmd += ["--resume", session_id]
    cmd += ["--output-format", "stream-json", "--include-partial-messages", "--verbose"]

    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    except FileNotFoundError:
        die("The `claude` CLI isn't installed.",
            "Install Claude Code, then run fern again: https://claude.com/claude-code")

    text, sid, started, api_error = "", session_id, False, None
    md = MDStream()
    sp = Spinner("thinking") if stream else None
    if sp:
        sp.__enter__()
    try:
        for line in proc.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            if ev.get("session_id"):
                sid = ev["session_id"]
            t = ev.get("type")
            if t == "stream_event":
                d = (ev.get("event") or {}).get("delta") or {}
                if d.get("type") == "text_delta":
                    chunk = d.get("text", "")
                    if chunk:
                        if not started:
                            if sp:
                                sp.clear()
                            started = True
                        if stream:
                            md.feed(chunk)
                        text += chunk
            elif t == "result":
                if ev.get("is_error") or ev.get("subtype") not in (None, "success"):
                    api_error = (ev.get("result") or "").strip() or "unknown error"
                    break
                if not text:
                    text = ev.get("result", "") or ""
                    if stream and text:
                        if sp and not started:
                            sp.clear()
                            started = True
                        md.feed(text)
        proc.wait()
    finally:
        if sp and not started:
            sp.clear()
        if stream:
            md.flush()

    if api_error:
        low = api_error.lower()
        def has(*words):
            return any(re.search(r"\b" + w + r"\w*", low) for w in words)
        hint = None
        if has("unauthorized", "authenticat", "login", "forbidden"):
            hint = "Run:  claude   and sign in."
        elif has("certificate", "ssl", "proxy", "network", "connect", "timeout", "dns"):
            hint = "Network problem. `fern due` and `fern status` still work offline."
        elif has("rate", "quota", "overloaded", "429"):
            hint = "Rate limited — wait a moment and ask again."
        elif has("credit", "billing"):
            hint = "Check your Claude plan or billing."
        print()
        lines = ansi_wrap(api_error.strip()[:400], width() - 4)
        if hint:
            lines += ["", S.gray(hint)]
        box("Claude returned an error", lines, S.red)
        print()
        return "", sid

    if proc.returncode != 0 and not text:
        err = (proc.stderr.read() or "").strip()
        if "auth" in err.lower() or "login" in err.lower():
            die("The `claude` CLI isn't logged in.", "Run:  claude   then sign in.")
        die("claude exited with an error.", err.splitlines()[-1] if err else None)

    return text, sid


def first_run():
    return not os.path.exists(WELCOMED)


def mark_welcomed():
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    with open(WELCOMED, "w") as f:
        f.write(datetime.now().astimezone().isoformat(timespec="seconds") + "\n")


def welcome():
    """Shown once, the first time someone runs `fern`."""
    clear_screen()
    banner()
    box("First time here", [
        f"{S.bold('Fern knows your actual coursework')} — your classes, what's due,",
        "what you're missing, and what each thing is worth. Then you just talk",
        "to it: what to do tonight, why you're stuck, build me a study packet.",
        "",
        f"{S.gray('Nothing leaves this machine except the questions you type.')}",
    ], S.green)
    print()
    print(f"  {S.bold('How do you want to start?')}")
    print()
    for n, label, note in [
        ("1", "Try it with a fake semester", "no setup, works right now"),
        ("2", "Connect my real Canvas", "needs an access token, ~2 min"),
        ("3", "Just chat", "nothing loaded, ask it anything"),
    ]:
        print(f"    {S.cyan(n)}  {fit(S.bold(label), 30)}{S.gray(note)}")
    print()

    try:
        pick = input(f"  {S.cyan(ARROW)} {S.gray('1, 2 or 3 (enter = 1)')}: ").strip() or "1"
    except (EOFError, KeyboardInterrupt):
        print()
        pick = "3"

    mark_welcomed()

    if pick == "1":
        print()
        cmd_demo(argparse.Namespace(force=False))
        print(f"  {S.gray('Try:')} {S.bold('what should i work on tonight')}")
    elif pick == "2":
        print()
        info("The easiest way needs no token at all: in Claude Code run")
        print(f"    {S.mag('/canvas')} {S.gray('and it reads the Canvas you are already logged into.')}")
        print()
        try:
            go = input(f"  {S.cyan(ARROW)} Set up token access here instead? "
                       f"{S.gray('y/N')}: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print(); go = "n"
        if go.startswith("y"):
            cmd_setup(argparse.Namespace(url=None, token=None, yes=False))
        else:
            print()
            info(f"No problem. {S.cyan('fern demo')} gives you fake data any time,")
            print(f"    {S.gray('or use')} {S.mag('/canvas')} {S.gray('in Claude Code for the real thing.')}")
    else:
        print()
        info(f"Fine. {S.cyan('fern demo')} loads a fake semester whenever you want one.")

    if not skills_installed() and bundled_skills():
        print()
        info("Fern also ships 11 skills for Claude Code — /tutor, /triage,")
        info("/packet, /plan-week and the rest.")
        try:
            yes = input(f"  {S.cyan(ARROW)} Install them? {S.gray('Y/n')}: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print(); yes = "n"
        if not yes.startswith("n"):
            cmd_install(argparse.Namespace(force=False))

    print()
    if os.path.exists(SNAPSHOT):
        box("You're in", [
            f"{S.bold('Type a question and press enter.')} That's the whole interface.",
            "",
            f"  {S.cyan('what should i work on tonight')}",
            f"  {S.cyan('whats due this week')}",
            f"  {S.cyan('build me a study packet for the chem midterm')}",
            "",
            f"{S.gray('/help for commands  ·  /due for the list  ·  /exit to quit')}",
        ], S.green)
    else:
        box("You're in", [
            f"{S.bold('Type a question and press enter.')} That's the whole interface.",
            "",
            f"{S.gray('No coursework loaded, so it will not know your classes yet.')}",
            f"  {S.cyan('fern demo')}   load a fake semester",
            f"  {S.mag('/canvas')}     in Claude Code, to pull your real one",
        ], S.green)
    print()


CHAT_HELP = [
    f"{S.cyan('/due')}       what's overdue and coming up",
    f"{S.cyan('/packet')}    build a study packet for a test",
    f"{S.cyan('/sync')}      refresh coursework from Canvas",
    f"{S.cyan('/status')}    what's configured",
    f"{S.cyan('/new')}       start a fresh conversation",
    f"{S.cyan('/help')}      this list",
    f"{S.cyan('/exit')}      quit  " + S.gray("(or ctrl-d)"),
    "",
    S.gray("Any other /command is passed to Claude — so /tutor, /triage,"),
    S.gray("/plan-week, /cram, /draft, /email and /learn all work here."),
    "",
    S.gray("Anything else is just a question. Ask it however you'd say it."),
]


def cmd_chat(args):
    just_welcomed = first_run()
    if just_welcomed:
        welcome()
    else:
        clear_screen()
        banner()

    if not have_claude():
        box("Chat needs the claude CLI", [
            f"{S.bold('fern chat runs on the `claude` CLI')} — that's how there's no second",
            "API key to set up. It isn't on your PATH right now.",
            "",
            f"  {S.cyan('https://claude.com/claude-code')}",
            "",
            "Everything else works without it:",
            f"  {S.cyan('fern demo')}    load a fake semester",
            f"  {S.cyan('fern due')}     what's overdue and coming up",
            f"  {S.cyan('fern status')}  what's configured",
        ], S.yellow)
        print()
        sys.exit(1)

    try:
        import readline  # noqa: F401  (gives arrow keys + history)
        os.makedirs(DIR, mode=0o700, exist_ok=True)
        try:
            readline.read_history_file(HISTFILE)
        except (FileNotFoundError, PermissionError):
            pass
        readline.set_history_length(500)
    except ImportError:
        readline = None

    have_snap = os.path.exists(SNAPSHOT)
    if just_welcomed:
        pass                      # the welcome box already covered all of this
    elif have_snap:
        with open(SNAPSHOT) as f:
            snap = json.load(f)
        n = sum(len(c["assignments"]) for c in snap["courses"])
        info(f"{len(snap['courses'])} courses, {n} assignments loaded")
    else:
        warn("No coursework synced. Run `fern demo` to try it with fake data,")
        warn("or `fern setup` / `/canvas` to pull in your real classes.")
    if not just_welcomed:
        info(f"Ask anything. {S.cyan('/help')} for commands, {S.cyan('/exit')} to quit.")
    print()

    sid = None
    while True:
        try:
            line = input(f"{S.cyan(S.bold(ARROW))} ").strip()
        except EOFError:
            print()
            break
        except KeyboardInterrupt:
            print()
            continue
        if not line:
            continue

        low = line.lower()
        if low in ("/exit", "/quit", "exit", "quit", ":q"):
            break
        if low == "/help":
            print()
            box("Commands", CHAT_HELP)
            print()
            continue
        if low == "/new":
            sid = None
            ok("Fresh conversation.")
            print()
            continue
        if low == "/due":
            cmd_due(argparse.Namespace(days=7))
            continue
        if low == "/status":
            cmd_status(argparse.Namespace())
            continue
        if low == "/sync":
            try:
                c = load_creds()
                print()
                do_sync(c["canvas_url"], c["token"], None)
                print()
            except SystemExit:
                pass
            continue

        print()
        try:
            _, sid = ask_claude(line, sid)
        except KeyboardInterrupt:
            print()
            info("Stopped.")
        print()

    try:
        import readline
        readline.write_history_file(HISTFILE)
        os.chmod(HISTFILE, 0o600)
    except Exception:
        pass
    print()
    info("Bye.")
    print()


def bundled_skills():
    """Where the SKILL.md folders live next to this script, if they shipped."""
    here = os.path.dirname(os.path.abspath(__file__))
    for cand in (os.path.join(here, "..", "skills"), os.path.join(here, "skills")):
        if os.path.isdir(cand):
            return os.path.abspath(cand)
    return None


def skills_installed():
    return os.path.isdir(os.path.expanduser("~/.claude/skills/tutor"))


def cmd_install(args):
    """Copy the bundled skills into ~/.claude/skills (what install.sh does,
    but available when fern came from npx)."""
    import shutil as sh
    src = bundled_skills()
    if not src:
        die("Can't find the bundled skills next to this script.",
            "Clone the repo and run ./install.sh instead.")
    dest = os.path.expanduser("~/.claude/skills")
    os.makedirs(dest, exist_ok=True)
    print()
    added = skipped = 0
    for name in sorted(os.listdir(src)):
        s = os.path.join(src, name)
        if not os.path.isdir(s):
            continue
        d = os.path.join(dest, name)
        if os.path.exists(d) and not args.force:
            info(f"/{name} already there")
            skipped += 1
            continue
        sh.rmtree(d, ignore_errors=True)
        sh.copytree(s, d)
        ok(f"/{name}")
        added += 1
    print()
    if added:
        info(f"{added} installed to {dest}")
        info("Restart Claude Code, then type / to see them.")
    if skipped and not args.force:
        info(f"{skipped} skipped — use --force to overwrite.")
    print()


def cmd_demo(args):
    """Load a fake but realistic semester so you can try fern without Canvas."""
    import copy
    data = copy.deepcopy(DEMO_SEMESTER)

    now = datetime.now().astimezone()
    midnight = now.replace(hour=0, minute=0, second=0, microsecond=0)
    for c in data["courses"]:
        for a in c["assignments"]:
            off = a.pop("_due_offset_days", None)
            hhmm = a.pop("_due_time", None) or [23, 59]
            a["due"] = None if off is None else \
                (midnight + timedelta(days=off, hours=hhmm[0], minutes=hhmm[1])).isoformat()
    data["pulled_at"] = now.isoformat(timespec="seconds")

    if os.path.exists(SNAPSHOT) and not args.force:
        with open(SNAPSHOT) as f:
            existing = json.load(f)
        if existing.get("source") != "demo":
            die("You already have real coursework synced.",
                "`fern demo --force` overwrites it. To keep a copy first:\n"
                f"    cp {SNAPSHOT} ~/coursework-backup.json")

    write_private(SNAPSHOT, data)
    n = sum(len(c["assignments"]) for c in data["courses"])
    banner()
    box("Demo semester loaded", [
        f"{len(data['courses'])} courses, {n} assignments — dated relative to today, so",
        "there's always something overdue and something due tomorrow.",
        "",
        f"{S.cyan('fern')}          start chatting about it",
        f"{S.cyan('fern due')}      see the list",
        f"{S.cyan('fern packet')}   build a study packet for the CHEM midterm",
        "",
        f"{S.gray('Fake data. Nothing is connected to a real Canvas.')}",
        f"{S.gray('Clear it with:')} {S.cyan('fern revoke --all')}",
    ], S.green)
    print()


def cmd_doctor(args):
    """Why don't I see the colors / why doesn't chat work."""
    banner()
    rule("checks")
    print()

    tty = sys.stdout.isatty()
    (ok if tty else warn)(
        f"stdout is a terminal: {tty}"
        + ("" if tty else "  — piped or redirected, so colors auto-off"))

    term = os.environ.get("TERM", "(unset)")
    (ok if term not in ("dumb", "(unset)") else warn)(f"TERM = {term}")

    if os.environ.get("NO_COLOR") is not None:
        warn("NO_COLOR is set — that's what's disabling colors. Unset it.")
    else:
        ok("NO_COLOR not set")

    (ok if S.on else warn)(f"color output: {'on' if S.on else 'OFF'}"
                           + ("" if S.on else "  — force it with FORCE_COLOR=1"))

    c = shutil.which("claude")
    (ok if c else warn)(f"claude CLI: {c or 'not found — chat will not work'}")

    me = shutil.which("fern")
    (ok if me else warn)(f"fern on PATH: {me or 'no — you are running it by path'}")

    if os.path.exists(SNAPSHOT):
        with open(SNAPSHOT) as f:
            snap = json.load(f)
        src = snap.get("source", "browser")
        ok(f"coursework: {len(snap['courses'])} courses ({src})")
    else:
        warn("coursework: none — run `fern demo` for fake data")

    print()
    rule("color test")
    print()
    print("  " + "  ".join([S.red("red"), S.yellow("yellow"), S.green("green"),
                            S.cyan("cyan"), S.blue("blue"), S.mag("magenta"),
                            S.gray("gray"), S.bold("bold"), S.dim("dim")]))
    print(f"  {S.cyan('╭─── box ───╮')}   {S.cyan('⠋')} spinner   "
          f"{S.green(TICK)} {S.red(CROSS)} {S.cyan(DOT)} {S.cyan(ARROW)}")
    print()
    info("If that line is unreadable or shows boxes, your terminal font is missing")
    info("the glyphs. Everything still works — try a Nerd Font or JetBrains Mono.")
    print()


def cmd_packet(args):
    if not have_claude():
        die("`fern packet` needs the `claude` CLI.")
    what = " ".join(args.about) if args.about else ""
    print()
    ask_claude(f"/packet {what}".strip(), None)
    print()


def cmd_ask(args):
    if not have_claude():
        die("`fern ask` needs the `claude` CLI.", "Try:  fern due")
    print()
    ask_claude(" ".join(args.question), None)
    print()


def main():
    p = argparse.ArgumentParser(prog="fern", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"fern {VERSION}")
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("setup", help="guided setup")
    s.add_argument("--url")
    s.add_argument("--token", help="prefer $CANVAS_TOKEN — argv is visible in ps")
    s.add_argument("-y", "--yes", action="store_true", help="skip the risk prompt")
    s.set_defaults(func=cmd_setup)

    s = sub.add_parser("sync", help="pull coursework from Canvas")
    s.add_argument("--course", help="only courses matching this name/code")
    s.set_defaults(func=cmd_sync)

    s = sub.add_parser("due", help="what's overdue and coming up")
    s.add_argument("-d", "--days", type=int, default=7)
    s.set_defaults(func=cmd_due)

    sub.add_parser("test", help="verify the token").set_defaults(func=cmd_test)
    sub.add_parser("status", help="show config").set_defaults(func=cmd_status)

    s = sub.add_parser("revoke", help="delete the saved token")
    s.add_argument("--all", action="store_true", help="also delete the coursework snapshot")
    s.set_defaults(func=cmd_revoke)

    sub.add_parser("chat", help="chat (this is the default)").set_defaults(func=cmd_chat)

    s = sub.add_parser("ask", help="one question, one answer")
    s.add_argument("question", nargs="+")
    s.set_defaults(func=cmd_ask)

    s = sub.add_parser("packet", help="build a study packet")
    s.add_argument("about", nargs="*", help="course + what it covers")
    s.set_defaults(func=cmd_packet)

    sub.add_parser("doctor", help="why don't I see colors / why is chat broken") \
        .set_defaults(func=cmd_doctor)

    sub.add_parser("welcome", help="replay the first-run setup") \
        .set_defaults(func=lambda a: welcome())

    s = sub.add_parser("install", help="install the Claude Code skills")
    s.add_argument("-f", "--force", action="store_true", help="overwrite existing")
    s.set_defaults(func=cmd_install)

    s = sub.add_parser("demo", help="load a fake semester to try this out")
    s.add_argument("-f", "--force", action="store_true", help="overwrite real coursework")
    s.set_defaults(func=cmd_demo)

    args = p.parse_args()
    if not args.cmd:
        args = argparse.Namespace(cmd="chat", func=cmd_chat)
    try:
        args.func(args)
    except KeyboardInterrupt:
        print()
        info("Cancelled.")
        sys.exit(130)
    except BrokenPipeError:
        # piped into `head` or similar — exit quietly
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)


if __name__ == "__main__":
    main()
